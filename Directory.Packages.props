<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup Label="Library">
    <!-- Lowest version with NonCryptographicHashAlgorithm on all our targets; apps on newer versions unify upward. -->
    <PackageVersion Include="System.IO.Hashing" Version="8.0.0" />
  </ItemGroup>
  <ItemGroup Label="Library (netstandard polyfills)">
    <PackageVersion Include="System.Memory" Version="4.6.3" />
    <PackageVersion Include="System.Runtime.CompilerServices.Unsafe" Version="6.1.2" />
  </ItemGroup>
  <ItemGroup Label="Tests">
    <PackageVersion Include="xunit.v3" Version="4.0.3" />
    <PackageVersion Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.12.0" />
  </ItemGroup>
  <ItemGroup Label="Benchmarks">
    <!-- 0.16 preview: first BenchmarkDotNet version that knows .NET 11. Benchmarks only, never shipped. -->
    <PackageVersion Include="BenchmarkDotNet" Version="0.16.0-preview.2" />
    <PackageVersion Include="MurmurHash.Net" Version="0.0.2" />
    <PackageVersion Include="HashDepot" Version="3.2.0" />
    <PackageVersion Include="murmurhash" Version="1.0.3" />
    <PackageVersion Include="Data.HashFunction.MurmurHash" Version="3.1.2" />
    <PackageVersion Include="HashifyNET" Version="7.1.1" />
  </ItemGroup>
</Project>
