<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>$(TestTargetFrameworks)</TargetFrameworks>
    <IsPackable>false</IsPackable>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <AnalysisLevel>latest-minimum</AnalysisLevel>
    <Optimize>true</Optimize>
    <!-- Pass -p:LibraryTargetFramework=netstandard2.1 to benchmark the netstandard build of the library. -->
    <DefineConstants Condition="'$(LibraryTargetFramework)' != ''">$(DefineConstants);NETSTANDARD_LIBRARY</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" />
    <PackageReference Include="MurmurHash.Net" />
    <PackageReference Include="HashDepot" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\MurmurHash\MurmurHash.csproj" Condition="'$(LibraryTargetFramework)' == ''" />
    <ProjectReference Include="..\..\src\MurmurHash\MurmurHash.csproj" Condition="'$(LibraryTargetFramework)' != ''" SetTargetFramework="TargetFramework=$(LibraryTargetFramework)" />
  </ItemGroup>
</Project>
