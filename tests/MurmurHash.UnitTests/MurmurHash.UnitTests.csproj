<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>$(TestTargetFrameworks)</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <!-- Test naming (Method_Scenario_Result) intentionally uses underscores. -->
    <NoWarn>$(NoWarn);CA1707</NoWarn>
    <!-- Pass -p:LibraryTargetFramework=netstandard2.0 (or 2.1) to run the tests against the netstandard build. -->
    <DefineConstants Condition="'$(LibraryTargetFramework)' != ''">$(DefineConstants);NETSTANDARD_LIBRARY</DefineConstants>
    <LibraryTargetFramework Condition="'$(LibraryTargetFramework)' == ''"></LibraryTargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\MurmurHash\MurmurHash.csproj" Condition="'$(LibraryTargetFramework)' == ''" />
    <ProjectReference Include="..\..\src\MurmurHash\MurmurHash.csproj" Condition="'$(LibraryTargetFramework)' != ''" SetTargetFramework="TargetFramework=$(LibraryTargetFramework)" />
  </ItemGroup>

  <ItemGroup>
    <None Include="TestVectors\vectors.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
